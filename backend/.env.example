# ─────────────────────────────────────────────
# IP-SAKTI Backend — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ipsakti

# JWT
SECRET_KEY=change-this-to-a-secure-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-...

# Storage (Supabase / S3-compatible)
STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1
STORAGE_BUCKET=ipsakti-documents
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Admin
FIRST_ADMIN_EMAIL=admin@ipsakti.in
FIRST_ADMIN_PASSWORD=change-me
